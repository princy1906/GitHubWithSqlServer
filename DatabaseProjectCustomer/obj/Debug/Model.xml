		<Element Type="SqlProcedure" Name="[dbo].[usp_GetCustomers]">
			<Property Name="BodyScript">
				<Value><![CDATA[
BEGIN
    SET NOCOUNT ON;

    SELECT
        CustomerId,
        CustomerName,
        City,
        CreditLimit,
        RegistrationDate
    FROM Customer
    WHERE @City IS NULL
       OR City = @City;
END;]]></Value>
